---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FaqSection from '../../components/FaqSection.astro';
import { faqFor, faqJsonLd } from '../../lib/faq';
import Img from '../../components/Img.astro';
import EventList from '../../components/EventList.astro';
import { imgUrl } from '../../lib/image';
import { getStaticLocalePaths, localeFromParams, localePath, locales } from '../../i18n/config';
import { getContent } from '../../i18n/content';
import { absUrl, businessJsonLd, websiteJsonLd } from '../../i18n/site';

export function getStaticPaths() {
	return getStaticLocalePaths();
}

const locale = localeFromParams(Astro.params.lang);
const path = '/';
const { meta, hero, intro, cards, story, around, newsletter } = await getContent(
	locale,
	'homepage',
);
const ui = await getContent(locale, 'ui');
const agenda = await getContent(locale, 'agenda');
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(around.mapAddress)}&output=embed`;
const posterUrl = imgUrl(hero.poster, 1280, 'webp');

const faq = faqFor(locale, 'home');
const jsonLd = [
	...faqJsonLd(faq),
	websiteJsonLd({ inLanguage: locales[locale].htmlLang }),
	businessJsonLd({
		type: 'Restaurant',
		url: absUrl(localePath(locale, path)),
		description: meta.description,
		image: absUrl(hero.poster),
	}),
];

const button =
	'mt-6 inline-block rounded-full border border-rumo-navy px-8 py-3 text-sm font-medium tracking-wide uppercase hover:bg-rumo-navy hover:text-white';
---

<Layout
	locale={locale}
	path={path}
	title={meta.title}
	description={meta.description}
	image={hero.poster}
	jsonLd={jsonLd}
>
	<link slot="head" rel="preload" as="image" href={posterUrl} fetchpriority="high" />
	<Header locale={locale} path={path} />

	<!-- Hero -->
	<section class="relative flex h-[85vh] min-h-[560px] items-center justify-center overflow-hidden">
		<video
			id="hero-video"
			class="absolute inset-0 h-full w-full object-cover"
			data-src={hero.video}
			poster={posterUrl}
			preload="none"
			muted
			loop
			playsinline
			aria-hidden="true"></video>
		<script is:inline>
			(() => {
				const video = document.getElementById('hero-video');
				const connection = navigator.connection;
				const heavyOk =
					matchMedia('(min-width: 768px)').matches &&
					!matchMedia('(prefers-reduced-motion: reduce)').matches &&
					!(connection && connection.saveData);
				if (video && heavyOk) {
					video.src = video.dataset.src;
					video.play().catch(() => {});
				}
			})();
		</script>
		<div class="absolute inset-0 bg-rumo-navy/20"></div>
		<h1
			class="font-display relative px-6 text-center text-4xl font-bold tracking-wide text-white uppercase [text-shadow:0_2px_14px_rgba(0,0,0,0.5)] sm:text-6xl"
		>
			{hero.title}
			<span class="mt-4 block font-sans text-base font-medium tracking-[0.25em] sm:text-2xl">
				{hero.subtitle}
			</span>
		</h1>
	</section>

	<!-- Intro -->
	<section class="bg-rumo-yellow px-6 py-24 text-center">
		<div class="mx-auto max-w-2xl">
			<h2 class="font-display text-3xl font-semibold sm:text-4xl">{intro.heading}</h2>
			<p class="mt-8 text-sm text-rumo-navy/80">{intro.body}</p>
		</div>
	</section>

	<!-- Beach Club / Surf Club -->
	<section class="bg-rumo-pink px-6 py-24">
		<div class="mx-auto grid max-w-5xl gap-10 sm:grid-cols-2">
			{
				cards.map(
					(card: {
						title: string;
						body: string;
						image: string;
						imageAlt: string;
						href: string;
						buttonLabel: string;
					}) => (
						<div class="flex flex-col">
							<a href={localePath(locale, card.href)} class="block overflow-hidden rounded-xl">
								<Img
									src={card.image}
									alt={card.imageAlt}
									class="aspect-4/3 w-full object-cover transition-transform duration-500 hover:scale-105"
									widths={[480, 800, 1000]}
									sizes="(min-width: 1024px) 480px, (min-width: 640px) 45vw, 90vw"
								/>
							</a>
							<h2 class="font-display mt-6 text-2xl font-semibold">
								<a href={localePath(locale, card.href)}>{card.title}</a>
							</h2>
							<p class="mt-2 text-sm text-rumo-navy/80">{card.body}</p>
							<div>
								<a href={localePath(locale, card.href)} class={button}>
									{card.buttonLabel}
								</a>
							</div>
						</div>
					),
				)
			}
		</div>
	</section>

	<!-- Há um tempo atrás -->
	<section class="bg-rumo-purple px-6 py-24">
		<div class="mx-auto grid max-w-5xl gap-12 sm:grid-cols-2 sm:items-center">
			<div>
				<h2 class="font-display text-3xl font-semibold sm:text-4xl">{story.heading}</h2>
				<div class="mt-6 space-y-4 text-sm text-rumo-navy/80">
					{story.paragraphs.map((p: string) => <p class="whitespace-pre-line">{p}</p>)}
				</div>
			</div>
			<Img
				src={story.image}
				alt={story.imageAlt}
				class="aspect-4/3 w-full rounded-xl object-cover"
				widths={[480, 800, 1000]}
				sizes="(min-width: 1024px) 480px, (min-width: 640px) 45vw, 90vw"
			/>
		</div>
	</section>

	<!-- What's on (agenda) -->
	<section class="bg-rumo-cream px-6 py-24" id="events">
		<div class="mx-auto max-w-3xl">
			<div class="text-center">
				<h2 class="font-display text-3xl font-semibold sm:text-4xl">{agenda.heading}</h2>
				<p class="mt-4 text-sm text-rumo-navy/70">{agenda.intro}</p>
			</div>
			<div class="mt-10">
				<EventList locale={locale} limit={3} />
			</div>
			<div class="mt-10 text-center">
				<a href={localePath(locale, '/events/')} class={button}>{agenda.viewAll}</a>
			</div>
		</div>
	</section>

	<!-- À volta do Rumo -->
	<section class="bg-rumo-yellow px-6 py-24 text-center">
		<div class="mx-auto max-w-2xl">
			<h2 class="font-display text-3xl font-semibold sm:text-4xl">{around.heading}</h2>
			<p class="mt-6 text-sm text-rumo-navy/80">{around.body}</p>
		</div>
		<div class="mx-auto mt-10 max-w-5xl overflow-hidden rounded-xl">
			<iframe title={ui.mapTitle} class="h-96 w-full border-0" loading="lazy" src={mapSrc}></iframe>
		</div>
	</section>

	<!-- Newsletter -->
	<section class="bg-rumo-cream px-6 py-24 text-center" id="contactos">
		<div class="mx-auto max-w-xl">
			<h2 class="font-display text-3xl font-semibold sm:text-4xl">{newsletter.heading}</h2>
			<p class="mt-4 text-sm text-rumo-navy/70">{newsletter.body}</p>
			<form class="mt-8 flex flex-col gap-3 sm:flex-row">
				<input
					type="email"
					required
					placeholder={ui.emailPlaceholder}
					aria-label={ui.emailPlaceholder}
					class="w-full rounded-full border border-rumo-navy/30 bg-white px-5 py-3 text-sm"
				/>
				<button
					type="submit"
					class="rounded-full bg-rumo-yellow px-8 py-3 text-sm font-medium tracking-wide uppercase hover:bg-rumo-gold"
				>
					{newsletter.buttonLabel}
				</button>
			</form>
		</div>
	</section>

	<FaqSection locale={locale} items={faq} />

	<Footer locale={locale} />
</Layout>

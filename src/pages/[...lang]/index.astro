---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Img from '../../components/Img.astro';
import { imgUrl } from '../../lib/image';
import { getStaticLocalePaths, localeFromParams, localePath, locales } from '../../i18n/config';
import { getContent } from '../../i18n/content';
import { absUrl, businessJsonLd, websiteJsonLd } from '../../i18n/site';

export function getStaticPaths() {
	return getStaticLocalePaths();
}

const locale = localeFromParams(Astro.params.lang);
const path = '/';
const { meta, hero, intro, gallery, marEMesa, surfClub, newsletter } = await getContent(
	locale,
	'homepage',
);
const ui = await getContent(locale, 'ui');
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(surfClub.mapAddress)}&output=embed`;

const jsonLd = [
	websiteJsonLd({ inLanguage: locales[locale].htmlLang }),
	businessJsonLd({
		type: 'Restaurant',
		url: absUrl(localePath(locale, path)),
		description: meta.description,
		image: absUrl(hero.poster),
	}),
];
const posterUrl = imgUrl(hero.poster, 1280, 'webp');
---

<Layout
	locale={locale}
	path={path}
	title={meta.title}
	description={meta.description}
	image={hero.poster}
	jsonLd={jsonLd}
>
	<link slot="head" rel="preload" as="image" href={posterUrl} fetchpriority="high" />
	<Header locale={locale} path={path} />

	<!-- Hero -->
	<section class="relative flex h-[85vh] min-h-[560px] items-center justify-center overflow-hidden">
		<video
			id="hero-video"
			class="absolute inset-0 h-full w-full object-cover"
			data-src={hero.video}
			poster={posterUrl}
			preload="none"
			muted
			loop
			playsinline
			aria-hidden="true"
		></video>
		<script is:inline>
			(() => {
				const video = document.getElementById('hero-video');
				const connection = navigator.connection;
				const heavyOk =
					matchMedia('(min-width: 768px)').matches &&
					!matchMedia('(prefers-reduced-motion: reduce)').matches &&
					!(connection && connection.saveData);
				if (video && heavyOk) {
					video.src = video.dataset.src;
					video.play().catch(() => {});
				}
			})();
		</script>
		<div class="absolute inset-0 bg-rumo-navy/20"></div>
		<h1
			class="font-display relative text-5xl font-bold tracking-wide text-white uppercase sm:text-6xl"
		>
			{hero.title}
		</h1>
	</section>

	<!-- Intro / Beach Club -->
	<section id="beach-club" class="bg-rumo-yellow px-6 py-24 text-center">
		<div class="mx-auto max-w-2xl">
			<h2 class="font-display text-3xl font-semibold sm:text-4xl">{intro.heading}</h2>
			<div class="mt-8 space-y-4 text-sm text-rumo-navy/80">
				<p class="font-semibold">{intro.subheading}</p>
				<p>{intro.body}</p>
			</div>
			<a
				href={intro.buttonHref}
				class="mt-8 inline-block rounded-full border border-rumo-navy px-8 py-3 text-sm font-medium tracking-wide uppercase hover:bg-rumo-navy hover:text-white"
			>
				{intro.buttonLabel}
			</a>
		</div>
	</section>

	<!-- Gallery strip -->
	<section class="grid grid-cols-1 sm:grid-cols-3">
		{
			gallery.map((item: { image: string; alt: string }) => (
				<Img
					src={item.image}
					alt={item.alt}
					class="aspect-4/5 w-full object-cover"
					widths={[480, 800, 1200]}
					sizes="(min-width: 640px) 33vw, 100vw"
				/>
			))
		}
	</section>

	<!-- Entre o mar e a mesa -->
	<section class="bg-rumo-pink px-6 py-24">
		<div class="mx-auto grid max-w-5xl gap-12 sm:grid-cols-2 sm:items-center">
			<div>
				<h2 class="font-display text-3xl font-semibold sm:text-4xl">{marEMesa.heading}</h2>
				<div class="mt-6 space-y-4 text-sm text-rumo-navy/80">
					{marEMesa.paragraphs.map((p: string) => <p>{p}</p>)}
				</div>
				<a
					href={marEMesa.buttonHref}
					class="mt-8 inline-block rounded-full border border-rumo-navy px-8 py-3 text-sm font-medium tracking-wide uppercase hover:bg-rumo-navy hover:text-white"
				>
					{marEMesa.buttonLabel}
				</a>
			</div>
			<Img
				src={marEMesa.image}
				alt={marEMesa.imageAlt}
				class="aspect-4/5 w-full rounded-xl object-cover"
				widths={[480, 800, 1000]}
				sizes="(min-width: 1024px) 40vw, (min-width: 640px) 45vw, 90vw"
			/>
		</div>
	</section>

	<!-- Surf club -->
	<section id="surf-club" class="bg-rumo-purple px-6 py-24 text-center">
		<div class="mx-auto max-w-2xl">
			<h2 class="font-display text-3xl font-semibold sm:text-4xl">{surfClub.heading}</h2>
			<p class="mt-6 text-sm text-rumo-navy/80">{surfClub.body}</p>
		</div>
		<Img
			src={surfClub.image}
			alt={surfClub.imageAlt}
			class="mx-auto mt-10 aspect-21/9 w-full max-w-5xl rounded-xl object-cover"
			widths={[800, 1280, 1600]}
			sizes="(min-width: 1024px) 1024px, 100vw"
		/>
		<div class="mx-auto mt-6 max-w-5xl overflow-hidden rounded-xl">
			<iframe title={ui.mapTitle} class="h-96 w-full border-0" loading="lazy" src={mapSrc}></iframe>
		</div>
	</section>

	<!-- Newsletter -->
	<section class="bg-rumo-cream px-6 py-24 text-center" id="contactos">
		<div class="mx-auto max-w-xl">
			<h2 class="font-display text-3xl font-semibold sm:text-4xl">{newsletter.heading}</h2>
			<p class="mt-4 text-sm text-rumo-navy/70">{newsletter.body}</p>
			<form class="mt-8 flex flex-col gap-3 sm:flex-row">
				<input
					type="email"
					required
					placeholder={ui.emailPlaceholder}
					aria-label={ui.emailPlaceholder}
					class="w-full rounded-full border border-rumo-navy/30 bg-white px-5 py-3 text-sm"
				/>
				<button
					type="submit"
					class="rounded-full bg-rumo-yellow px-8 py-3 text-sm font-medium tracking-wide uppercase hover:bg-rumo-gold"
				>
					{newsletter.buttonLabel}
				</button>
			</form>
		</div>
	</section>

	<Footer locale={locale} />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FaqSection from '../../components/FaqSection.astro';
import { faqFor, faqJsonLd } from '../../lib/faq';
import Img from '../../components/Img.astro';
import { getStaticLocalePaths, localeFromParams, localePath } from '../../i18n/config';
import { getContent } from '../../i18n/content';
import { absUrl, breadcrumbJsonLd, businessJsonLd } from '../../i18n/site';

export function getStaticPaths() {
	return getStaticLocalePaths();
}

const locale = localeFromParams(Astro.params.lang);
const path = '/beach-club/';
const { meta, hero, intro, gallery, marEMesa } = await getContent(locale, 'beachClub');

const ui = await getContent(locale, 'ui');
const business = businessJsonLd({
	type: 'Restaurant',
	url: absUrl(localePath(locale, path)),
	description: meta.description,
	image: absUrl(hero.image),
});
const faq = faqFor(locale, 'beach-club');
const jsonLd = [
	...faqJsonLd(faq),
	business,
	breadcrumbJsonLd([
		{ name: ui.nav.home, path: localePath(locale, '/') },
		{ name: ui.nav.beachClub, path: localePath(locale, path) },
	]),
];
---

<Layout
	locale={locale}
	path={path}
	title={meta.title}
	description={meta.description}
	image={hero.image}
	jsonLd={jsonLd}
>
	<Header locale={locale} path={path} transparent={false} />

	<!-- Page hero -->
	<section class="relative flex h-[45vh] min-h-[320px] items-center justify-center overflow-hidden">
		<Img
			src={hero.image}
			alt=""
			class="absolute inset-0 h-full w-full object-cover"
			widths={[800, 1280, 1920]}
			loading="eager"
			fetchpriority="high"
		/>
		<div class="absolute inset-0 bg-rumo-navy/30"></div>
		<h1
			class="font-display relative text-5xl font-bold tracking-wide text-white uppercase sm:text-6xl"
		>
			{hero.title}
		</h1>
	</section>

	<!-- Intro -->
	<section class="bg-rumo-yellow px-6 py-24 text-center">
		<div class="mx-auto max-w-2xl">
			<h2 class="font-display text-3xl font-semibold sm:text-4xl">{intro.heading}</h2>
			<div class="mt-8 space-y-4 text-sm text-rumo-navy/80">
				<p class="font-semibold">{intro.subheading}</p>
				<p>{intro.body}</p>
			</div>
			<a
				href={intro.buttonHref}
				class="mt-8 inline-block rounded-full border border-rumo-navy px-8 py-3 text-sm font-medium tracking-wide uppercase hover:bg-rumo-navy hover:text-white"
			>
				{intro.buttonLabel}
			</a>
		</div>
	</section>

	<!-- Gallery strip -->
	<section class="grid grid-cols-1 sm:grid-cols-3">
		{
			gallery.map((item: { image: string; alt: string }) => (
				<Img
					src={item.image}
					alt={item.alt}
					class="aspect-4/5 w-full object-cover"
					widths={[480, 800, 1200]}
					sizes="(min-width: 640px) 33vw, 100vw"
				/>
			))
		}
	</section>

	<!-- Entre o mar e a mesa -->
	<section class="bg-rumo-pink px-6 py-24">
		<div class="mx-auto grid max-w-5xl gap-12 sm:grid-cols-2 sm:items-center">
			<div>
				<h2 class="font-display text-3xl font-semibold sm:text-4xl">{marEMesa.heading}</h2>
				<div class="mt-6 space-y-4 text-sm text-rumo-navy/80">
					{marEMesa.paragraphs.map((p: string) => <p>{p}</p>)}
				</div>
				<a
					href={marEMesa.buttonHref}
					class="mt-8 inline-block rounded-full border border-rumo-navy px-8 py-3 text-sm font-medium tracking-wide uppercase hover:bg-rumo-navy hover:text-white"
				>
					{marEMesa.buttonLabel}
				</a>
			</div>
			<Img
				src={marEMesa.image}
				alt={marEMesa.imageAlt}
				class="aspect-4/5 w-full rounded-xl object-cover"
				widths={[480, 800, 1000]}
				sizes="(min-width: 1024px) 40vw, (min-width: 640px) 45vw, 90vw"
			/>
		</div>
	</section>

	<FaqSection locale={locale} items={faq} />

	<Footer locale={locale} />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Img from '../../components/Img.astro';
import { getStaticLocalePaths, localeFromParams, localePath } from '../../i18n/config';
import { getContent } from '../../i18n/content';
import { absUrl, breadcrumbJsonLd, businessJsonLd } from '../../i18n/site';

export function getStaticPaths() {
	return getStaticLocalePaths();
}

const locale = localeFromParams(Astro.params.lang);
const path = '/surf-club/';
const surfClub = await getContent(locale, 'surfClub');
const ui = await getContent(locale, 'ui');
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(surfClub.mapAddress)}&output=embed`;

const business = businessJsonLd({
	type: 'SportsActivityLocation',
	url: absUrl(localePath(locale, path)),
	description: surfClub.meta.description,
	image: absUrl(surfClub.hero.image),
});
const jsonLd = [
	business,
	breadcrumbJsonLd([
		{ name: ui.nav.home, path: localePath(locale, '/') },
		{ name: ui.nav.surfClub, path: localePath(locale, path) },
	]),
];
---

<Layout
	locale={locale}
	path={path}
	title={surfClub.meta.title}
	description={surfClub.meta.description}
	image={surfClub.hero.image}
	jsonLd={jsonLd}
>
	<Header locale={locale} path={path} transparent={false} />

	<!-- Page hero -->
	<section class="relative flex h-[50vh] min-h-[360px] items-center justify-center overflow-hidden">
		<Img
			src={surfClub.hero.image}
			alt=""
			class="absolute inset-0 h-full w-full object-cover"
			widths={[800, 1280, 1920]}
			loading="eager"
			fetchpriority="high"
		/>
		<div class="absolute inset-0 bg-rumo-navy/40"></div>
		<div class="relative mx-auto max-w-2xl px-6 text-center text-white">
			<h1 class="font-display text-4xl font-bold tracking-wide uppercase sm:text-5xl">
				{surfClub.hero.title}
			</h1>
			<p class="mt-4 text-sm text-white/90">{surfClub.hero.body}</p>
			<a
				href={surfClub.ctaHref}
				target="_blank"
				rel="noopener"
				class="mt-8 inline-block rounded-full bg-rumo-yellow px-8 py-3 text-sm font-medium tracking-wide text-rumo-navy uppercase hover:bg-rumo-gold"
			>
				{surfClub.ctaLabel}
			</a>
		</div>
	</section>

	<!-- Offerings -->
	<section class="bg-rumo-purple px-6 py-24">
		<div class="mx-auto grid max-w-5xl gap-8 sm:grid-cols-2 lg:grid-cols-3">
			{
				surfClub.offerings.map((o: { title: string; body: string }) => (
					<div class="rounded-xl border border-rumo-navy/10 bg-rumo-cream p-6">
						<h2 class="font-display text-xl font-semibold">{o.title}</h2>
						<p class="mt-2 text-sm text-rumo-navy/80">{o.body}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- Packages (deep links to Bookinglayer) -->
	<section class="bg-rumo-cream px-6 py-24" id="packages">
		<div class="mx-auto max-w-5xl">
			<div class="text-center">
				<h2 class="font-display text-3xl font-semibold sm:text-4xl">{surfClub.packages.heading}</h2>
				<p class="mt-4 text-sm text-rumo-navy/70">{surfClub.packages.intro}</p>
			</div>
			<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
				{
					surfClub.packages.items.map((pkg: { title: string; body: string; href: string }) => (
						<div class="flex flex-col rounded-xl border border-rumo-navy/10 bg-white p-6">
							<h3 class="font-display text-lg font-semibold">{pkg.title}</h3>
							<p class="mt-2 flex-1 text-sm text-rumo-navy/80">{pkg.body}</p>
							<a
								href={pkg.href}
								target="_blank"
								rel="noopener"
								class="mt-6 inline-block rounded-full bg-rumo-yellow px-6 py-2.5 text-center text-xs font-medium tracking-wide uppercase hover:bg-rumo-gold"
							>
								{surfClub.packages.buttonLabel}
							</a>
						</div>
					))
				}
			</div>
			<div class="mt-12 text-center">
				<a
					href={surfClub.ctaHref}
					target="_blank"
					rel="noopener"
					class="inline-block rounded-full border border-rumo-navy px-8 py-3 text-sm font-medium tracking-wide uppercase hover:bg-rumo-navy hover:text-white"
				>
					{surfClub.ctaLabel}
				</a>
			</div>
		</div>
	</section>

	<!-- Photo + map -->
	<Img
		src={surfClub.image}
		alt={surfClub.imageAlt}
		class="h-[45vh] min-h-[320px] w-full object-cover"
		widths={[800, 1280, 1920]}
		sizes="100vw"
	/>
	<section class="bg-rumo-cream px-6 py-16">
		<div class="mx-auto max-w-5xl overflow-hidden rounded-xl">
			<iframe title={ui.mapTitle} class="h-96 w-full border-0" loading="lazy" src={mapSrc}></iframe>
		</div>
	</section>

	<Footer locale={locale} />
</Layout>

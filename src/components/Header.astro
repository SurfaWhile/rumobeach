---
const links = {
	left: [
		{ href: '#surf-club', label: 'Surf Club' },
		{ href: '#beach-club', label: 'Beach Club' },
	],
	right: [
		{ href: '#contactos', label: 'Contactos' },
		{ href: '#equipa', label: 'Equipa' },
		{ href: '#', label: 'EN' },
	],
};
---

<header class="absolute inset-x-0 top-0 z-10 text-white">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6">
		<nav class="hidden gap-6 text-xs font-medium tracking-wide uppercase sm:flex">
			{
				links.left.map((l) => (
					<a href={l.href} class="hover:text-rumo-gold">
						{l.label}
					</a>
				))
			}
		</nav>
		<a href="#" class="font-display text-2xl font-bold tracking-wide text-rumo-gold">RUMO</a>
		<nav class="hidden gap-6 text-xs font-medium tracking-wide uppercase sm:flex">
			{
				links.right.map((l) => (
					<a href={l.href} class="hover:text-rumo-gold">
						{l.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

---
import { locales, localeCodes, localePath, type Locale } from '../i18n/config';
import { getContent } from '../i18n/content';

interface Props {
	locale: Locale;
	path?: string;
	transparent?: boolean;
}

const { locale, path = '/', transparent = true } = Astro.props;
const ui = await getContent(locale, 'ui');

const home = localePath(locale, '/');
const left = [
	{ href: localePath(locale, '/surf-club/'), label: ui.nav.surfClub },
	{ href: localePath(locale, '/beach-club/'), label: ui.nav.beachClub },
];
const right = [
	{ href: localePath(locale, '/contactos/'), label: ui.nav.contacts },
	{ href: localePath(locale, '/equipa/'), label: ui.nav.team },
];

// Sticky op alle pagina's. Op de homepage ligt het menu transparant over de
// hero (fixed) en krijgt het een crèmekleurige achtergrond zodra er gescrold wordt.
const headerClass = [
	'group z-50 transition-colors duration-200',
	transparent
		? 'fixed inset-x-0 top-0 text-white data-[scrolled]:bg-rumo-cream data-[scrolled]:text-rumo-navy data-[scrolled]:shadow-sm'
		: 'sticky top-0 border-b border-rumo-navy/10 bg-rumo-cream text-rumo-navy',
].join(' ');
---

<header class={headerClass} data-site-header data-transparent={transparent ? '' : undefined}>
	<div
		class:list={[
			'mx-auto flex max-w-6xl items-center justify-between px-6 transition-[padding] duration-200',
			transparent ? 'py-6 group-data-[scrolled]:py-3' : 'py-4',
		]}
	>
		<div class="flex flex-1 items-center">
			<nav class="hidden gap-6 text-xs font-medium tracking-wide whitespace-nowrap uppercase lg:flex">
				{left.map((l) => <a href={l.href} class="hover:text-rumo-gold">{l.label}</a>)}
			</nav>

			<details class="relative lg:hidden">
				<summary
					class="flex cursor-pointer list-none items-center [&::-webkit-details-marker]:hidden"
					aria-label={ui.menuButton}
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						class="h-6 w-6"
						aria-hidden="true"
					>
						<path d="M4 7h16M4 12h16M4 17h16"></path>
					</svg>
				</summary>
				<nav
					class="absolute top-full left-0 mt-3 flex w-56 flex-col gap-4 rounded-xl bg-rumo-cream p-5 text-xs font-medium tracking-wide text-rumo-navy uppercase shadow-lg"
				>
					{[...left, ...right].map((l) => <a href={l.href}>{l.label}</a>)}
				</nav>
			</details>
		</div>

		<a href={home} class="flex flex-col items-center">
			<img
				src="/images/rumobeach/logo-amarelo.png"
				alt={ui.logoAlt}
				class:list={[
					'h-10 w-auto',
					transparent ? 'group-data-[scrolled]:brightness-0' : 'brightness-0',
				]}
			/>
			<span
				class:list={[
					'mt-1 text-[10px] leading-none font-medium tracking-[0.25em] whitespace-nowrap uppercase',
					{ 'group-data-[scrolled]:hidden': transparent },
				]}
			>
				{ui.tagline}
			</span>
		</a>

		<div class="flex flex-1 items-center justify-end gap-6">
			<nav class="hidden gap-6 text-xs font-medium tracking-wide whitespace-nowrap uppercase lg:flex">
				{right.map((l) => <a href={l.href} class="hover:text-rumo-gold">{l.label}</a>)}
			</nav>
			<ul class="flex gap-3 text-xs font-medium tracking-wide" aria-label={ui.languageLabel}>
				{
					localeCodes.map((code) => (
						<li>
							<a
								href={localePath(code, path)}
								hreflang={locales[code].htmlLang}
								lang={locales[code].htmlLang.split('-')[0]}
								title={locales[code].name}
								aria-current={code === locale ? 'true' : undefined}
								class:list={[
									'hover:opacity-100',
									code === locale ? 'font-bold underline underline-offset-4' : 'opacity-70',
								]}
							>
								{locales[code].label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</header>

<script is:inline>
	(() => {
		const header = document.querySelector('[data-site-header][data-transparent]');
		if (!header) return;
		const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 24);
		update();
		addEventListener('scroll', update, { passive: true });
	})();
</script>

---
import { imgUrl, imgSrcset } from '../lib/image';

interface Props {
	src: string;
	alt: string;
	widths?: number[];
	sizes?: string;
	class?: string;
	loading?: 'lazy' | 'eager';
	fetchpriority?: 'high' | 'low' | 'auto';
}

const {
	src,
	alt,
	widths = [480, 800, 1200, 1600],
	sizes = '100vw',
	class: className,
	loading = 'lazy',
	fetchpriority,
} = Astro.props;

const fallbackWidth = widths[Math.floor(widths.length / 2)];
---

<picture class="contents">
	<source class="hidden" type="image/avif" srcset={imgSrcset(src, widths, 'avif')} sizes={sizes} />
	<source class="hidden" type="image/webp" srcset={imgSrcset(src, widths, 'webp')} sizes={sizes} />
	<img
		src={imgUrl(src, fallbackWidth, 'webp')}
		alt={alt}
		class={className}
		loading={loading}
		decoding="async"
		fetchpriority={fetchpriority}
	/>
</picture>

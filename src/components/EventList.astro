---
// Lijst met komende evenementen. Bouwt de komende evenementen statisch op en verbergt
// in de browser wat intussen voorbij is, zodat de agenda ook zonder nieuwe build klopt.
import type { Locale } from '../i18n/config';
import { getContent } from '../i18n/content';
import { upcomingEvents, formatParts } from '../lib/events';
import Img from './Img.astro';

interface Props {
	locale: Locale;
	/** Maximaal aantal te tonen evenementen (alleen homepage). */
	limit?: number;
}

const { locale, limit } = Astro.props;
const t = await getContent(locale, 'agenda');
// Bij een limiet extra opbouwen, voor het geval de eerste al voorbij zijn bij het laden.
const events = upcomingEvents(locale, limit ? limit + 6 : undefined);
---

<div data-event-list data-limit={limit}>
	<ul class="grid gap-5">
		{
			events.map((e) => {
				const d = formatParts(e.date, locale);
				const until = e.endDate !== e.date ? formatParts(e.endDate, locale) : null;
				return (
					<li
						data-event
						data-end={e.endDate}
						class="flex gap-5 rounded-xl border border-rumo-navy/10 bg-white p-5 sm:gap-6 sm:p-6"
					>
						<div class="w-16 shrink-0 text-center sm:w-20">
							<p class="text-xs font-medium tracking-wide uppercase text-rumo-navy/60">{d.weekday}</p>
							<p class="font-display text-4xl leading-none font-semibold">{d.day}</p>
							<p class="mt-1 text-xs font-medium tracking-wide uppercase text-rumo-navy/60">{d.month}</p>
						</div>
						<div class="min-w-0 flex-1">
							<h3 class="font-display text-xl font-semibold">{e.title}</h3>
							{(e.time || until) && (
								<p class="mt-1 text-xs font-medium tracking-wide uppercase text-rumo-navy/60">
									{[e.time, until && `${t.untilLabel} ${until.long}`].filter(Boolean).join(' · ')}
								</p>
							)}
							{e.description && <p class="mt-3 text-sm whitespace-pre-line text-rumo-navy/80">{e.description}</p>}
							{e.link && (
								<a
									href={e.link}
									target="_blank"
									rel="noopener"
									class="mt-4 inline-block rounded-full border border-rumo-navy px-5 py-2 text-xs font-medium tracking-wide uppercase hover:bg-rumo-navy hover:text-white"
								>
									{t.moreInfo}
								</a>
							)}
						</div>
						{e.image && (
							<Img
								src={e.image}
								alt=""
								class="hidden aspect-4/3 w-40 shrink-0 self-start rounded-lg object-cover sm:block"
								widths={[320, 480]}
								sizes="160px"
							/>
						)}
					</li>
				);
			})
		}
	</ul>
	<p data-event-empty class:list={['text-center text-sm text-rumo-navy/70', { hidden: events.length > 0 }]}>
		{t.empty}
	</p>
</div>

<script is:inline>
	(() => {
		const today = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Lisbon' }).format(new Date());
		document.querySelectorAll('[data-event-list]').forEach((list) => {
			const limit = parseInt(list.getAttribute('data-limit') || '0', 10);
			let shown = 0;
			list.querySelectorAll('[data-event]').forEach((el) => {
				const past = el.getAttribute('data-end') < today;
				const over = limit && shown >= limit;
				el.hidden = past || over;
				if (!el.hidden) shown++;
			});
			const empty = list.querySelector('[data-event-empty]');
			if (empty) empty.hidden = shown > 0;
		});
	})();
</script>
